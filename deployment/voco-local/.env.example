VOCO_SERVER_HOST=0.0.0.0
VOCO_SERVER_PORT=8080
VOCO_SERVER_READ_TIMEOUT=10s
VOCO_SERVER_WRITE_TIMEOUT=10s

VOCO_SERVER_BASE_URL=http://localhost:5173

VOCO_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

VOCO_CACHE_TTL=24h

# Returned to the browser — must be reachable from the host, not from inside Docker.
VOCO_LIVEKIT_URL=ws://localhost:7880

VOCO_LIVEKIT_API_KEY=devkey
VOCO_LIVEKIT_API_SECRET=devsecret

VOCO_LIVEKIT_TOKEN_TTL=6h

# In Docker: host=postgres, migrations=/app/migrations
VOCO_PG_URL=postgres://voco:voco@postgres:5432/voco?sslmode=disable&search_path=voco
VOCO_PG_MIGRATIONS_PATH=/app/migrations

# Optional pool tuning (defaults are fine for local):
# VOCO_PG_MAX_CONNS=10
# VOCO_PG_MIN_CONNS=0
# VOCO_PG_MAX_CONN_LIFETIME=1h
# VOCO_PG_MAX_CONN_IDLE_TIME=30m
# VOCO_PG_CONNECT_TIMEOUT=5s

# Alternative to URL — individual fields (ignored when VOCO_PG_URL is set):
# VOCO_PG_HOST=postgres
# VOCO_PG_PORT=5432
# VOCO_PG_USER=voco
# VOCO_PG_PASSWORD=voco
# VOCO_PG_DATABASE=voco
# VOCO_PG_SCHEMA=voco
# VOCO_PG_SSLMODE=disable

# On host (make migrate-up, go run): use localhost and repo migrations/
# VOCO_PG_URL=postgres://voco:voco@localhost:5432/voco?sslmode=disable&search_path=voco
# Migrations (no search_path — schema is created by 000001):
# VOCO_PG_URL=postgres://voco:voco@localhost:5432/voco?sslmode=disable
# VOCO_PG_MIGRATIONS_PATH=migrations

VOCO_DEV_MODE=true
VOCO_RELEASE_MODE=dev

VOCO_LOG_FORMAT=text
VOCO_LOG_LEVEL=info
VOCO_LOG_SERVICE=voco-backend
VOCO_LOG_ENV=dev

# Keycloak (backend validates JWT). In Docker use http://keycloak:8080; on host use http://localhost:8180.
VOCO_KEYCLOAK_ENABLED=true
VOCO_KEYCLOAK_URL=http://keycloak:8080
VOCO_KEYCLOAK_REALM=voco
VOCO_KEYCLOAK_CLIENT_ID=voco-frontend

# Keycloak SMTP (applied by keycloak-realm-setup). Local defaults → Mailpit.
# UI: http://localhost:8025
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@voco.local
KC_SMTP_FROM_DISPLAY_NAME=VOCO
KC_SMTP_AUTH=false
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# Resend (real delivery) — for prod use deployment/k3s/secrets.env + keycloak-configmap.yaml
# KC_SMTP_HOST=smtp.resend.com
# KC_SMTP_PORT=587
# KC_SMTP_FROM=noreply@voco-online.ru
# KC_SMTP_FROM_DISPLAY_NAME=VOCO
# KC_SMTP_AUTH=true
# KC_SMTP_SSL=false
# KC_SMTP_STARTTLS=true
# KC_SMTP_USER=resend
# KC_SMTP_PASSWORD=CHANGE_ME

# Frontend (browser reaches Keycloak on host port)
# VITE_KEYCLOAK_URL=http://localhost:8180
# VITE_KEYCLOAK_REALM=voco
# VITE_KEYCLOAK_CLIENT_ID=voco-frontend
