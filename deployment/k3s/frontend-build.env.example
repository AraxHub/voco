# Non-secret frontend build args for production images.
# Copy optional overrides:
#   cp deployment/k3s/frontend-build.env.example deployment/k3s/frontend-build.env
# Then: ./deployment/k3s/build-images.sh
#
# Defaults match backend-configmap / keycloak-configmap domains.

VITE_API_BASE_URL=
VITE_KEYCLOAK_URL=https://auth.voco-online.ru
VITE_KEYCLOAK_REALM=voco
VITE_KEYCLOAK_CLIENT_ID=voco-frontend
