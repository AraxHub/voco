# Copy to secrets.env and fill ONLY the secret values (CHANGE_ME → real).
# Non-secret prod settings live in ConfigMaps under deployment/k8s/overlays/k3s/.
#
#   cp deployment/k3s/secrets.env.example deployment/k3s/secrets.env
#   nano deployment/k3s/secrets.env
#   ./deployment/k3s/create-secrets.sh
#   ./deployment/k3s/create-ghcr-pull-secret.sh   # для pull backend/frontend из GHCR
#
# secrets.env is gitignored — never commit real passwords/keys.

# ─── LiveKit (must match keys: in livekit-configmap.yaml) ───
VOCO_LIVEKIT_API_KEY=CHANGE_ME
VOCO_LIVEKIT_API_SECRET=CHANGE_ME

# ─── Postgres (backend). Prefer full URL with password. ───
# & in query string is fine — create-secrets.sh does not use `source`.
# Example:
# VOCO_PG_URL=postgres://voco:PASSWORD@155.212.190.163:5432/voco?sslmode=disable&search_path=voco
VOCO_PG_URL=CHANGE_ME

# ─── Keycloak admin bootstrap (when Keycloak is deployed) ───
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ─── Keycloak DB password (user/db name are non-secret; see keycloak-configmap) ───
KC_DB_PASSWORD=CHANGE_ME

# ─── SMTP for Keycloak (OTP / verify / reset). Password is secret. ───
# Host/port/from/flags → keycloak-configmap.yaml (non-secret).
KC_SMTP_USER=resend
KC_SMTP_PASSWORD=CHANGE_ME

# ─── GHCR pull (private packages). Classic PAT: read:packages. ───
# https://github.com/settings/tokens
GHCR_USERNAME=CHANGE_ME
GHCR_TOKEN=CHANGE_ME
# GHCR_EMAIL=noreply@users.noreply.github.com
